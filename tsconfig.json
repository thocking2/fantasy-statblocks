{
    "extends": "@tsconfig/svelte/tsconfig.json",
    "compilerOptions": {
        "baseUrl": ".",
        "ignoreDeprecations": "6.0",
        "rootDir": ".",
        "inlineSources": true,
        "module": "ESNext",
        "target": "es2020",
        "allowJs": true,
        "noImplicitAny": true,
        "moduleResolution": "bundler",
        "importHelpers": true,
        "experimentalDecorators": true,
        "types": ["svelte", "node", "jest"],
        "lib": ["dom", "esnext", "scripthost", "es2020"],
        "isolatedModules": false
    },
    "include": ["**/*.ts", "**/*.svelte"]
}
